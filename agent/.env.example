# agent/.env — machine-local secrets for the energy agent. NEVER commit the real file.
# Copy to agent/.env on each machine and fill in real values. The real .env is gitignored.
# A key committed once is compromised and must be rotated — keep values out of tracked files.

# Anthropic API key for the LLM narrative layer (sk-ant-...).
ANTHROPIC_API_KEY=

# Home Assistant — the agent talks to the local HA on the Pi.
HA_URL=http://localhost:8123
# Long-lived access token (Settings → Profile → Long-lived access tokens).
HA_TOKEN=

# Tessie — Powerwall control (backup_reserve_percent). Token from tessie.com.
TESSIE_TOKEN=
# Energy site id (an identifier, not a secret; default lives in energy_agent.py).
TESSIE_SITE_ID=
